<h2>Tạo phiếu nhập nháp</h2>
<div class="row">

  <div class="col-md-12 mb-3">
    <label for="publisher-status-filter" class="form-label">Lọc theo nhà xuất bản:</label>
    <select id="publisher-status-filter" class="form-select select2">
      <option value="">Tất cả</option>
      {{#each publishers}}
        <option value="{{this.publisher_id}}"
          {{#if (eq ../selectedPublisherId this.publisher_id)}}selected{{/if}}>
          {{this.publisher_name}}
        </option>
      {{/each}}
    </select>
  </div>

  {{#if hasPublisher}}
  <div class="col-md-6">
    <table id="importBookTable" class="display">
      <thead>
        <tr>
          <th>Tên sách</th>
          <th>Tác giả</th>
          <th>Nhà xuất bản</th>
          <th>Tồn kho</th>
          <th>Giá TB nhập</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
          <tr data-book-id="{{this.book_id}}"
              data-title="{{this.book_title}}"
              data-publisher-id="{{this.publisher_id}}">
            <td>{{this.book_title}}</td>
            <td>{{this.author_name}}</td>
            <td>{{this.publisher_name}}</td>
            <td>{{this.stock_quantity}}</td>
            <td>{{formatPrice this.avg_import_price}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="col-md-6 text-muted fst-italic">
    Vui lòng chọn nhà xuất bản để hiển thị danh sách sách
  </div>
  {{/if}}

  <div class="col-md-6">
    <h3>Sách đã chọn</h3>
    <form id="importForm" action="/admin/imports/add" method="POST">
      <input type="hidden" id="selectedPublisher" name="publisher_id">
      <div id="selectedBooks" class="mb-3"></div>
      <button type="submit" class="btn btn-success">
        <i class="bi bi-floppy"></i> Lưu nháp
      </button>
    </form>
  </div>
</div>

<script src="/js/admin/import.js"></script>
