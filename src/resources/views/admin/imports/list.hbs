<h2>Danh sách phiếu nhập</h2>

<div class="mb-3 d-flex justify-content-between align-items-center">
  <a href="/admin/imports/new" class="btn btn-primary">+ Tạo phiếu nhập</a>

  <form method="GET" action="/admin/imports">
    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()"
            style="min-width:160px">
      <option value="">Tất cả trạng thái</option>
      <option value="0" {{#if (eq selectedStatus '0')}}selected{{/if}}>Nháp</option>
      <option value="1" {{#if (eq selectedStatus '1')}}selected{{/if}}>Chờ duyệt</option>
      <option value="2" {{#if (eq selectedStatus '2')}}selected{{/if}}>Đã duyệt</option>
    </select>
  </form>
</div>

<table id="importsTable" class="display w-100">
  <thead>
    <tr>
      <th>ID</th>
      <th>Trạng thái</th>
      <th>Nhà xuất bản</th>
      <th>Người tạo</th>
      <th>Tổng SL</th>
      <th>Tổng chi phí</th>
      <th>Ngày tạo</th>
    </tr>
  </thead>
  <tbody>
    {{#each imports}}
      <tr class="import__row--click" data-id="{{this.import_id}}" style="cursor:pointer">
        <td>{{this.import_id}}</td>
        <td>
          {{#if (eq this.status 0)}}
            <span class="badge bg-secondary">Nháp</span>
          {{/if}}
          {{#if (eq this.status 1)}}
            <span class="badge bg-warning text-dark">Chờ duyệt</span>
          {{/if}}
          {{#if (eq this.status 2)}}
            <span class="badge bg-success">Đã duyệt</span>
          {{/if}}
        </td>
        <td>{{this.publisher_name}}</td>
        <td>{{this.created_by_name}}</td>
        <td>{{this.total_quantity}}</td>
        <td>{{formatPrice this.total_cost}} đ</td>
        <td>{{formatDate this.created_at}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<script src="/js/admin/imports_list.js"></script>
